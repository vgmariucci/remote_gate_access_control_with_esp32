/*
 * Copy to admin_credentials.h and edit. That file is gitignored: this
 * repository is public, and a committed default password is how IoT
 * devices get taken over.
 *
 * This is the development stand-in for the credential dongle. When the
 * dongle exists, these come off it over I2C and this header goes away.
 */
#ifndef ADMIN_CREDENTIALS_H
#define ADMIN_CREDENTIALS_H

/* Portal login. */
#define ADMIN_USERNAME "admin"
#define ADMIN_PASSWORD "change-me-before-you-flash-this"

/* WPA2 passphrase for the provisioning AP itself, 8-63 characters.
 * The AP is the outer gate: without this, anyone in radio range
 * reaches the login page at all. Put it on a label inside the
 * enclosure. */
#define PROV_AP_PASSWORD "change-me-too"

#endif /* ADMIN_CREDENTIALS_H */
