# Copy to .env and change both. .env must stay out of git - the
# repository is public.
POSTGRES_PASSWORD=change-me-before-you-forget

# Guards the admin routes. The API refuses to start without it, because
# an API that starts anyway is an API with no admin auth.
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-too

# The API's own connection. backend/dev_setup.sh prints this line
# with a freshly generated password; paste it over this one.
DATABASE_URL=postgresql://api_user:change-me@localhost:5432/gate

# Set to 1 only when something in front of the API overwrites
# X-Forwarded-For. A spoofable client address in an audit trail is
# worse than none.
TRUST_FORWARDED=0

# Where the signed body is published for the device to poll. Without
# this, nothing is published and a gate reading the bucket never sees a
# change - the API warns at startup when it is unset.
#
# The key is gate-<gate_id>.txt, which is what the device's URL ends in
# and what the bucket policy is scoped to.
S3_BUCKET=
S3_PREFIX=
AWS_REGION=us-east-1
# Credentials come from the usual AWS places: AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY here, or an instance role in production.
